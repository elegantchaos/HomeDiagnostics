{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HomeDiagnostics - Hue Devices",
      "program": "${workspaceFolder}/.build/debug/home-diagnostics",
      "args": [
        "--days",
        "7",
        "--hue-only",
        "--verbose",
        "--detailed"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "swift-build"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HomeDiagnostics - Quick Summary",
      "program": "${workspaceFolder}/.build/debug/home-diagnostics",
      "args": [
        "--days",
        "3",
        "--summary"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "swift-build"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HomeDiagnostics - Detailed Analysis",
      "program": "${workspaceFolder}/.build/debug/home-diagnostics",
      "args": [
        "--days",
        "7",
        "--detailed",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "swift-build"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HomeDiagnostics - Hue Deduplicated",
      "program": "${workspaceFolder}/.build/debug/home-diagnostics",
      "args": [
        "--days",
        "7",
        "--hue-only",
        "--dedupe",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "swift-build"
    },
    {
      "type": "swift",
      "request": "launch",
      "name": "Debug HomeDiagnostics - Raw Hue Logs",
      "program": "${workspaceFolder}/.build/debug/home-diagnostics",
      "args": [
        "--days",
        "3",
        "--hue-only",
        "--raw",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "swift-build"
    }
  ]
}
